# Copy to .env (gitignored) and fill in.
# Apply for API credentials at https://freesound.org/apiv2/apply
# "Client secret/Api key" goes here; enough for search and HQ-preview downloads.
FREESOUND_API_KEY=
# "Client id"; only needed for original-quality downloads (--original, after `auth`).
FREESOUND_CLIENT_ID=
