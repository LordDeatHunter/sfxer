{
  "name": "sfxer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/mcp",
    "packages/web"
  ],
  "scripts": {
    "dev": "vite packages/web",
    "start": "vite build packages/web && vite preview packages/web",
    "build": "tsc -b packages/core packages/cli packages/mcp",
    "build:web": "vite build packages/web",
    "test": "vitest run",
    "check": "python scripts/check_all.py",
    "sfx": "bun packages/cli/dist/main.js",
    "mcp": "bun packages/mcp/dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0",
    "vitest": "^5.1.1"
  }
}
